# ══════════════════════════════════════════════════════════════════════════
# LEX Backend — variáveis do WEB SERVICE em produção (Render)
#
# Este arquivo é um MODELO. Ele não é lido por nada e não tem valor real
# nenhum dentro — no Render, cada variável é preenchida no painel do serviço
# (Environment), e nunca commitada.
#
# Como usar no dia do deploy:
#   Render → o Web Service da API → Environment → Add Environment Variable,
#   uma por uma, com os valores reais. O guia passo a passo está no README.
#
# ⚠️ NUNCA cole segredo em arquivo versionado. Se um valor real aparecer aqui
#    num commit, ele precisa ser ROTACIONADO — apagar o commit não basta,
#    porque o histórico publicado não se reescreve (regra do projeto).
# ══════════════════════════════════════════════════════════════════════════

# ── OBRIGATÓRIAS ─────────────────────────────────────────────────────────

# Conexão do MongoDB Atlas, com o nome do banco no fim.
# Formato: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<banco>?retryWrites=true&w=majority
# O IP Access List do Atlas precisa aceitar 0.0.0.0/0: o plano gratuito do
# Render não tem IP de saída fixo.
MONGO_URI=

# Segredo de assinatura dos tokens da ADVOGADA. Gere com:  openssl rand -hex 32
JWT_SECRET=

# Segredo de assinatura dos tokens do PORTAL DO CLIENTE.
# Precisa existir e precisa ser DIFERENTE do JWT_SECRET — a aplicação se
# recusa a subir se estiver vazio ou se for igual (config/portalSecret.js), e
# a razão está lá: nome de cookie não é fronteira de segurança.
JWT_PORTAL_SECRET=

# Liga o modo de produção. Sem isto:
#   • o cookie de sessão sai SEM `secure` e SEM `sameSite: strict`;
#   • o HSTS não é enviado (passo 142 do roteiro);
#   • o rate limit fica 20× mais frouxo (passo 85 do roteiro);
#   • um 500 deixa de ser registrado por `utils/logError.js`.
NODE_ENV=production

# ── QUE O RENDER DEFINE SOZINHO ──────────────────────────────────────────

# PORT — o Render injeta e o `src/server.js` lê (`process.env.PORT || 3001`).
# **NÃO configure PORT no painel.** Fixá-lo num valor diferente do que a
# plataforma espera faz o health check falhar e o deploy ficar em "in progress"
# para sempre.

# ── OPCIONAIS, com os defaults de produção do código ─────────────────────

# Origens aceitas pelo CORS, separadas por vírgula.
#
# Na arquitetura desta fase o CORS NÃO é exercitado no caminho normal: o site
# serve `/api/*` na MESMA origem, por rewrite (ver README e DEC-061). Esta
# variável existe para o acesso DIRETO à URL do Web Service — e para o dia em
# que alguém abrir o front de outro domínio e precisar entender por que falha.
# Default do código, se ausente: http://localhost:5173
CORS_ORIGIN=https://<o-dominio-do-site>

# ── E-MAIL (A-2, DEC-064) — confirmação de conta e recuperação de senha ──
#
# Sem estas variáveis o sistema SOBE e funciona, mas nenhum e-mail sai: o
# cadastro e o login continuam normais, e a recuperação de senha responde igual
# (de propósito) sem enviar nada. Por isso elas não derrubam o deploy — e por
# isso é preciso conferir depois de configurar (passos 267 a 270 do roteiro).
#
# Provedor de e-mail por HTTP (sem SMTP: o plano gratuito do Render costuma
# bloquear a saída SMTP). Dois adaptadores prontos:
#   brevo   remetente único verificado (pode ser um Gmail); plano gratuito.
#   resend  exige DOMÍNIO próprio verificado para entregar a terceiros.
EMAIL_PROVIDER=<brevo-ou-resend>

# Chave de API do provedor. É SEGREDO: só no painel, nunca em arquivo.
EMAIL_API_KEY=<chave-da-api-do-provedor>

# Endereço remetente, o MESMO que foi verificado no provedor.
EMAIL_FROM=<remetente-verificado@exemplo.com>

# Nome exibido no remetente. Opcional; o padrão é "LEX".
#   EMAIL_FROM_NAME

# Endereço público do SITE, sem barra no fim — é a base dos links dos e-mails
# (`<APP_URL>/confirmar-email?token=...`). Vem do ambiente e não da requisição de
# propósito: com `Host` o link de recuperação de uma conta alheia poderia apontar
# para o site de um atacante. Sem ela em produção, o e-mail não é enviado.
APP_URL=https://<o-dominio-do-site>

# Tetos do rate limit por janela de 15 minutos. Os defaults de PRODUÇÃO já são
# estes — **não os baixe**, são a proteção real contra força bruta.
#   RATE_LIMIT_CADASTRO      (default 5)
#   RATE_LIMIT_LOGIN         (default 10)
#   RATE_LIMIT_SENHA         (default 5)
#   RATE_LIMIT_PORTAL_LOGIN  (default 5)
#   RATE_LIMIT_RECUPERACAO   (default 5)   pedir recuperação de senha
#   RATE_LIMIT_REENVIO       (default 5)   reenviar a confirmação de e-mail
#   RATE_LIMIT_TOKEN         (default 20)  usar um link de e-mail
#   RATE_LIMIT_JANELA_MINUTOS (default 15)
#
# RATE_LIMIT_MULTIPLICADOR sobrepõe o fator do ambiente. Em produção ele é 1 e
# **não deve ser configurado**: pô-lo em 20 aqui é o mesmo que desligar o
# limite, e sem aviso nenhum na tela.

# ── QUE NÃO SE CONFIGURA NO SERVIDOR ─────────────────────────────────────
#
# LEX_CONFIRMA_BANCO é a guarda dos comandos destrutivos (`reset:dev`,
# `seed:*`). Ela é digitada na MÃO, no terminal de quem roda o script, e não
# tem o que fazer no ambiente de um serviço publicado. Se ela existir no
# painel, alguém pré-autorizou um comando destrutivo contra a base real.
