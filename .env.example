# ── LEX Backend — variáveis de ambiente ──────────────────────────────
# Copie este arquivo para ".env" (cp .env.example .env) e preencha os valores.

# MongoDB Atlas — string de conexão do cluster
# Formato: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=

# Segredo para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=

# Porta do backend
PORT=3001

# Origem(ns) permitida(s) pelo CORS — URL do frontend Vite.
# Aceita múltiplas separadas por vírgula (cobre as portas 5173 e 5174 do Vite).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Ambiente. Mantenha "development" localmente.
# NÃO use "production" localmente: o cookie de sessão vira Secure e não grava em http://localhost.
NODE_ENV=development

# ── Rate limit dos endpoints de autenticação ─────────────────────────────
# Tentativas permitidas por janela, por IP. Os valores abaixo JÁ SÃO os
# defaults do código — deixar tudo comentado mantém exatamente o que vale
# hoje em produção. Descomente só para endurecer o limite.
#
# Fora de produção (NODE_ENV != "production") cada teto é multiplicado por
# 20 automaticamente, para testar o cadastro seis vezes seguidas em
# desenvolvimento não travar a sessão de trabalho por 15 minutos.
#
# RATE_LIMIT_CADASTRO=5
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_SENHA=5
# RATE_LIMIT_JANELA_MINUTOS=15
